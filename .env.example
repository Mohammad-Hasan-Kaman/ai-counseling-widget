# --- Required ---
# Password for the seeded demo tenant's admin user (username: demo)
ADMIN_PANEL_PASSWORD=<redacted>
# Long random secret: signs panel sessions and derives the Fernet key that
# encrypts per-tenant LLM API keys at rest. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_hex_string
# Super admin (platform operator) credentials
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=<redacted>

# --- Site / widget origins ---
# Comma-separated origins allowed to call the chat API (CORS)
CORS_ORIGINS=https://example.com,https://www.example.com,http://localhost:8000
# The site the widget is embedded on (used for embed/referrer checks)
WIDGET_ORIGIN=https://example.com
# The primary (demo) tenant's public team page. The availability crawler
# reads the consultant list from this page and profile links are built
# against it. Point it at the center's real team page in production.
TEAM_PAGE_URL=https://example.com/team/

# --- Crawler ---
# 1 = scheduled availability crawl for the primary tenant is enabled
CRAWLER_ENABLED=1

# --- Cookies ---
# Behind HTTPS (production): set 1 so the panel cookie is only sent over HTTPS
COOKIE_SECURE=0

# --- Optional path overrides (defaults live in ./data) ---
# USER_RECORDS_DB=/path/to/user_records.db
# APPOINTMENTS_DB=/path/to/appointments.db
# AI_KNOWLEDGE_DB=/path/to/ai_knowledge.db
# PROFILES_JSON=/path/to/consultants_profile_full.json
# MAPPING_JSON=/path/to/mapping.json
# CRAWL_STALE_AFTER_SECONDS=21600
